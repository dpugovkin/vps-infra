# Project manifest — read by infra's register-project.sh and backup engine.
# Copy to your project's deploy/project.env on the VPS and fill in your values.
#
# NOTE: your DB password is NOT in this file. The operator adds it to /opt/infra/.env
# as <PROJECT_NAME>_PASSWORD (uppercased, hyphens -> underscores). See the guide.

# --- required by register-project.sh ---
PROJECT_NAME=myapp                 # [A-Za-z0-9_-]; unique per box. Names the vhost,
                                   # conf.d/locations/<name>/, the DB-password lookup,
                                   # and the backup dir (/var/backups/<name>).
DOMAIN=myapp.example.com           # hostname for the nginx vhost + TLS certificate
UPSTREAM=myapp:8080                # your app's container:port on infra-net. The host part
                                   # MUST be a UNIQUE alias on the shared network.
DB_NAME=myapp                      # [A-Za-z0-9_]
DB_USER=myapp                      # [A-Za-z0-9_]

# --- required by the backup/restore engine ---
PROJECT_DIR=/opt/myapp             # absolute path to this project on the VPS

# --- optional ---
# CSP="default-src 'self'; img-src 'self' data: https:; script-src 'self'"
#   Per-project Content-Security-Policy (sent Report-Only). Omit for a safe self-only default.

# Redirect www.<DOMAIN> -> <DOMAIN> with a 301 (canonical apex host). Optional; omit to leave
# www unhandled. Requires the TLS cert to also cover www.<DOMAIN> (issue/expand with -d www.<DOMAIN>).
# WWW_REDIRECT=1
