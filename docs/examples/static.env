# Static-site manifest — read by infra's register-static-site.sh.
# Copy to your project's deploy/static.env on the VPS and fill in your values.
#
# NOTE: there is no DB password for static sites. Do NOT set UPSTREAM here —
# the script hard-codes static:8080 automatically.

# --- required by register-static-site.sh ---
PROJECT_NAME=myapp                 # [A-Za-z0-9_-]; unique per box. Names the static
                                   # server-block conf file and the edge vhost.
DOMAIN=example.com                 # hostname for the nginx vhost + TLS certificate
STATIC_FALLBACK=spa                # spa = SPA/client-routing (index.html fallback);
                                   # static = plain site (404 fallback)

# --- optional ---
# CSP="default-src 'self'; img-src 'self' data: https:; script-src 'self'"
#   Per-site Content-Security-Policy (sent Report-Only on the edge vhost).
#   Omit for a safe self-only default.

# Redirect www.<DOMAIN> -> <DOMAIN> with a 301 (canonical apex host). Optional; omit to leave
# www unhandled. Requires the TLS cert to also cover www.<DOMAIN> (issue/expand with -d www.<DOMAIN>).
# WWW_REDIRECT=1
