MARIADB_ROOT_PASSWORD=
# Shared Redis password — REQUIRED on the multi-tenant infra box. Generate with `openssl rand -hex 32`.
# Empty value means no auth; only safe for fully isolated dev environments.
REDIS_PASSWORD=

# --- shared backup mechanism (infra/backup/backup.sh) — local-only ---
BACKUP_GPG_PASSPHRASE=
BACKUP_REQUIRE_ENV_BACKUP=1
BACKUP_LOCAL_DAYS=14
